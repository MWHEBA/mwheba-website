# MWHEBA 2.0 Isolated POC Environment
PAYLOAD_SECRET=mwheba_poc_super_secret_key_at_least_32_characters_long_for_security

# Database connection:
# Default local PostgreSQL daemon on standard port:
DATABASE_URI=postgres://postgres@127.0.0.1:5432/mwheba_poc
# Standard local PostgreSQL service:
# DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/mwheba_poc
# SQLite fallback:
# DATABASE_URI=file:./mwheba_poc.db

PORT=3000

# cPanel persistent private directory outside public_html (required in production)
PRIVATE_UPLOAD_DIR=/home/ACCOUNT/private_uploads
# Set a unique secret of at least 32 characters in the hosting environment
PRIVATE_MEDIA_SIGNING_KEY=

# Paymob Sandbox Credentials (Required for Track 1B only)
# PAYMOB_API_KEY=
# PAYMOB_SECRET_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_CARD_INTEGRATION_ID=
# PAYMOB_WALLET_INTEGRATION_ID=
