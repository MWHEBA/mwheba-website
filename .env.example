# MWHEBA 2.0 Environment Configuration
# ====================================

# Node & Next.js Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Primary PostgreSQL Application Database
# Local development default connects to standard port 5432:
DATABASE_URI=postgres://postgres@127.0.0.1:5432/mwheba_dev

# Payload CMS Authentication & Session Secret (minimum 32 characters)
PAYLOAD_SECRET=replace_with_a_secure_random_32_character_secret_key_here

# Private File Storage (Customer Artwork & Production Files)
# MUST be an absolute path located OUTSIDE cPanel public_html in production
PRIVATE_UPLOAD_DIR=C:/Users/UTD/Desktop/MWHEBA Agency/private-uploads
MEDIA_SIGNING_SECRET=replace_with_a_secure_signing_secret_for_expiring_urls

# Payment Gateways
# Phase 1 Launch: Cash on Delivery (COD) + Manual Bank Transfer are active.
# Paymob is formally deferred to Phase 2 (Decision D-008).
ENABLE_PAYMOB_GATEWAY=false
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_HMAC_SECRET=
